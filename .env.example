# Copy this file to .env and fill in real values. .env is gitignored.
#
# Connection to Part 1's PostgreSQL warehouse, used by scripts/export_gold.py
# and nothing else. The attach is READ_ONLY, so a read-only role is enough and
# is the better choice if you have one.
#
# These default to Part 1's own docker-compose values. Start just the database
# with:
#   (cd ../football-data-engineering && docker compose up -d postgres)

GOLD_PG_HOST=localhost
GOLD_PG_PORT=5432
GOLD_PG_DB=football_dw
GOLD_PG_USER=football
GOLD_PG_PASSWORD=football
