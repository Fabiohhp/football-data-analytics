# Secrets. Only .env.example is tracked.
.env

# Generated data. The DuckDB store is rebuilt by dbt. The Gold snapshot is committed, so
# a fresh clone reproduces every number without Part 1; scripts/export_gold.py refreshes
# it. The directory itself is tracked through .gitkeep: DuckDB will not create a missing
# parent directory, so without it `dbt build` fails on a fresh clone with an IO error
# that points at the wrong thing.
data/*
!data/.gitkeep
!data/gold/

# Dashboard JSON, written by scripts/export_site_data.py from the marts.
site/data/

# dbt working directories.
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
