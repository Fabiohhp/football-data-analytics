# Secrets. Only .env.example is tracked.
.env

# Generated data. The Gold snapshot and the DuckDB store are rebuilt by
# scripts/export_gold.py + dbt, and §13 of CLAUDE.md has not yet decided whether any
# of it may be published. The directory itself is tracked through .gitkeep: DuckDB
# will not create a missing parent directory, so without it `dbt build` fails on a
# fresh clone with an IO error that points at the wrong thing.
data/*
!data/.gitkeep

# Dashboard JSON, written by scripts/export_site_data.py from the marts.
site/data/

# dbt working directories.
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
